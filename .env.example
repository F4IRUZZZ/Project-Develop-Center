# Contoh env — salin ke .env.local lalu isi. JANGAN commit .env.local.
GITHUB_ID=isi-client-id-oauth-app
GITHUB_SECRET=isi-client-secret-oauth-app
NEXTAUTH_SECRET=isi-string-acak-min-32-karakter
# Dev default http://localhost:3000 (isi saat deploy)
# NEXTAUTH_URL=http://localhost:3000
# Neon pooled connection string + kunci enkripsi 64 hex (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.xxx.neon.tech/neondb?sslmode=require
ENCRYPTION_KEY=isi-64-karakter-hex
# Secret webhook GitHub (isi 64 hex, ditempel juga di Settings > Webhooks tiap repo)
GITHUB_WEBHOOK_SECRET=isi-64-karakter-hex
